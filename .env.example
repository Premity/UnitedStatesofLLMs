# ── Copy to .env and fill in ──────────────────────────────────────────────────
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys — gitleaks runs in CI and in the
# pre-commit hook, but the only reliable guard is not pasting them here.

# ── API keys ──────────────────────────────────────────────────────────────────
# Presenter and both attackers — Groq free tier.
# https://console.groq.com/keys
GROQ_API_KEY=

# Not currently used by any role's default (see COUNCIL_JUDGE_MODEL below) --
# Gemini's free tier turned out to be a dead end for both judge and attacker
# candidates. Kept here in case that changes; see ISSUES.md.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge — OpenRouter, for nvidia/nemotron-3-ultra-550b-a55b:free.
# Free account, no payment method needed for :free-suffixed models.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: hosted attacker backend for demos without a local GPU.
# Cloudflare Workers AI free tier — 10,000 neurons/day (~30 single-case runs).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ── Model roster ──────────────────────────────────────────────────────────────
# LiteLLM model ids: <provider>/<model>. Changing a backend is a config change,
# never a code change — see docs/adr/0002-litellm-model-gateway.md.

COUNCIL_PRESENTER_MODEL=groq/openai/gpt-oss-120b
COUNCIL_PRESENTER_TEMPERATURE=0.4

# Gemini's Gemma 4 models (gemma-4-31b-it, gemma-4-26b-a4b-it) were tried here
# first but turned out to have a widely-reported, unresolved 500/503 problem
# on Google's free-tier serving — see ISSUES.md. Moved to Groq instead.
COUNCIL_ATTACKER_DOCTRINAL_MODEL=groq/qwen/qwen3.8-27b
COUNCIL_ATTACKER_DOCTRINAL_TEMPERATURE=0.7

COUNCIL_ATTACKER_EVIDENTIARY_MODEL=groq/openai/gpt-oss-20b
COUNCIL_ATTACKER_EVIDENTIARY_TEMPERATURE=0.7

# Gemini's free tier was a dead end (see ISSUES.md); groq/openai/gpt-oss-120b
# worked but put judge in the same model family as the presenter, undermining
# independence. nemotron-3-ultra restores a real fourth family. Whichever
# model is used, record it with the results: the judge sets every confidence
# the calibration metrics score, so a judge swap mid-run makes the
# calibration numbers incomparable.
COUNCIL_JUDGE_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
COUNCIL_JUDGE_TEMPERATURE=0.2

# Where Ollama lives.
#   host.docker.internal  — Ollama on your machine (default; teammates share one model store)
#   http://ollama:11434   — the optional compose profile: docker compose --profile ollama up -d
COUNCIL_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Passed to backends that honour it. Does not guarantee determinism.
COUNCIL_SEED=

# ── Retrieval ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ihl_corpus

# fastembed (ONNX) model name. Must match what the indexer used, or every
# similarity score is meaningless. See docs/adr/0001-no-torch-fastembed.md.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── Service ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Three of the four roles run on free-tier quotas; unbounded concurrency
# exhausts them and every in-flight run fails together.
MAX_CONCURRENT_DEBATES=2

# ── Production only ───────────────────────────────────────────────────────────
FRONTEND_PORT=80
