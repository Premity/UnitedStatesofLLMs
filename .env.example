# ── Copy to .env and fill in ──────────────────────────────────────────────────
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys — gitleaks runs in CI and in the
# pre-commit hook, but the only reliable guard is not pasting them here.

# ── API keys ──────────────────────────────────────────────────────────────────
# Presenter — Mistral API free tier (~1B tokens/month)
# https://console.mistral.ai/
MISTRAL_API_KEY=

# Judge — Google AI Studio free tier (100 requests/day)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: hosted attacker backend for demos without a local GPU.
# Cloudflare Workers AI free tier — 10,000 neurons/day (~30 single-case runs).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ── Model roster ──────────────────────────────────────────────────────────────
# LiteLLM model ids: <provider>/<model>. Changing a backend is a config change,
# never a code change — see docs/adr/0002-litellm-model-gateway.md.

COUNCIL_PRESENTER_MODEL=mistral/magistral-medium-latest
COUNCIL_PRESENTER_TEMPERATURE=0.4

COUNCIL_ATTACKER_DOCTRINAL_MODEL=ollama/qwen3.5:14b
COUNCIL_ATTACKER_DOCTRINAL_TEMPERATURE=0.7

COUNCIL_ATTACKER_EVIDENTIARY_MODEL=ollama/gemma3:12b
COUNCIL_ATTACKER_EVIDENTIARY_TEMPERATURE=0.7

COUNCIL_JUDGE_MODEL=gemini/gemini-2.5-pro
COUNCIL_JUDGE_TEMPERATURE=0.2

# Where Ollama lives.
#   host.docker.internal  — Ollama on your machine (default; teammates share one model store)
#   http://ollama:11434   — the optional compose profile: docker compose --profile ollama up -d
COUNCIL_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Passed to backends that honour it. Does not guarantee determinism.
COUNCIL_SEED=

# ── Retrieval ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ihl_corpus

# fastembed (ONNX) model name. Must match what the indexer used, or every
# similarity score is meaningless. See docs/adr/0001-no-torch-fastembed.md.
EMBEDDING_MODEL=BAAI/bge-m3

# ── Service ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Three of the four roles run on free-tier quotas; unbounded concurrency
# exhausts them and every in-flight run fails together.
MAX_CONCURRENT_DEBATES=2

# ── Production only ───────────────────────────────────────────────────────────
FRONTEND_PORT=80
