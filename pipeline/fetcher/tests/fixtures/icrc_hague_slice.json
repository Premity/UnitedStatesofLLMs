    {
      "type": "paragraph--treaty_content",
      "id": "e7ff33bf-0a60-4038-9ee0-b1be86695d9b",
      "links": {
        "self": {
          "href": "http://ihl-databases.icrc.org/en/jsonapi/paragraph/treaty_content/e7ff33bf-0a60-4038-9ee0-b1be86695d9b?resourceVersion=id%3A1693508"
        },
        "working-copy": {
          "href": "http://ihl-databases.icrc.org/en/jsonapi/paragraph/treaty_content/e7ff33bf-0a60-4038-9ee0-b1be86695d9b?resourceVersion=rel%3Aworking-copy"
        }
      },
      "attributes": {
        "_has_content": true,
        "field_treaty_content_content": "<p class=\"treaty__description-paragraph-sm\">In addition to the prohibitions provided by special Conventions, it is especially forbidden</p>\n\n<p class=\"treaty__description-paragraph-sm\">(a) To employ poison or poisoned weapons;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(b) To kill or wound treacherously individuals belonging to the hostile nation or army;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(c) To kill or wound an enemy who, having laid down his arms, or having no longer means of defence, has surrendered at discretion;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(d) To declare that no quarter will be given;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(e) To employ arms, projectiles, or material calculated to cause unnecessary suffering;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(f) To make improper use of a flag of truce, of the national flag or of the military insignia and uniform of the enemy, as well as the distinctive badges of the Geneva Convention;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(g) To destroy or seize the enemy's property, unless such destruction or seizure be imperatively demanded by the necessities of war;</p>\n\n<p class=\"treaty__description-paragraph-sm\">(h) To declare abolished, suspended, or inadmissible in a court of law the rights and actions of the nationals of the hostile party. A belligerent is likewise forbidden to compel the nationals of the hostile party to take part in the operations of war directed against their own country, even if they were in the belligerent's service before the commencement of the war.</p>",
        "field_treaty_content_list_title": "Regulations: Art. 23",
        "field_treaty_content_pre_title": "Regulations: Art. 23",
        "field_treaty_content_section": "Annex",
        "field_treaty_content_title": "Regulations: Art. 23",
        "field_treaty_content_unid": "regulations-art-23"
      },
