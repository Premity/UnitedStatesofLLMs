    {
      "type": "paragraph--treaty_content",
      "id": "90b2c7b6-3a0e-4053-bf31-bb81d1a81caa",
      "links": {
        "self": {
          "href": "http://ihl-databases.icrc.org/en/jsonapi/paragraph/treaty_content/90b2c7b6-3a0e-4053-bf31-bb81d1a81caa?resourceVersion=id%3A1693488"
        },
        "working-copy": {
          "href": "http://ihl-databases.icrc.org/en/jsonapi/paragraph/treaty_content/90b2c7b6-3a0e-4053-bf31-bb81d1a81caa?resourceVersion=rel%3Aworking-copy"
        }
      },
      "attributes": {
        "_has_content": true,
        "field_treaty_content_content": "<p class=\"treaty__description-paragraph-sm\">The armed forces of the belligerent parties may consist of combatants and non-combatants. In the case of capture by the enemy, both have a right to be treated as prisoners of war.</p>",
        "field_treaty_content_list_title": "Regulations: Art. 3",
        "field_treaty_content_pre_title": "Regulations: Art. 3",
        "field_treaty_content_section": "Annex",
        "field_treaty_content_title": "Regulations: Art. 3",
        "field_treaty_content_unid": "regulations-art-3"
      },
      "relationships": {
