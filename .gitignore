# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv-python/
venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
runtime/frontend/dist/
runtime/frontend/.vite/
*.tsbuildinfo

# ── Data ──────────────────────────────────────────────────────────────────────
# Fetched jurisprudence, embeddings, and run artifacts are all reproducible
# from the manifests and the code. The manifests are committed; this is not.
data/cache/
data/index/
data/runs/
data/eval/
data/logs/
data/scratch
*.log

# Keep the directory structure so a fresh clone has somewhere to write.
!data/cache/.gitkeep
!data/index/.gitkeep
!data/runs/.gitkeep
!data/eval/.gitkeep
!data/logs/.gitkeep

# ── Corpus ────────────────────────────────────────────────────────────────────
# Tier 1 treaty text IS committed — it is small, canonical, and worth diffing.
# Tier 2 jurisprudence is fetched into data/cache/ and is not.
corpus/**/*.pdf
corpus/**/*.raw.html

# ── Evaluation output ─────────────────────────────────────────────────────────
evaluation/reports/*.html
evaluation/reports/*.json
!evaluation/reports/.gitkeep

# ── Editors & OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.local.yml

# Figure generator bytecode
docs/diagrams/__pycache__/

# Scratch artwork. This repository is public, and src/img/ holds reference
# images that are not cleared for it -- courtroom.png is the Ace Attorney
# courtroom, (c) Capcom, kept locally while the room was being drawn (see
# "Courtroom background art" in ISSUES.md). The rule stays for that reason.
#
# The favicon source is the exception: it is the project's own emblem, and
# the icons under public/ are generated from it by
# scripts/build_favicons.py, which cannot run without it.
# Written as a contents glob, not `src/img/`: git does not descend into an
# excluded directory, so a negation inside one never takes effect.
runtime/frontend/src/img/*
!runtime/frontend/src/img/favicon.png
