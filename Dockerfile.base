# syntax=docker/dockerfile:1
#
# Shared base image for every Python service in this repo.
#
# There is no torch here, and that is deliberate: embeddings run through
# fastembed's ONNX runtime, which is ~200MB against PyTorch+CUDA's ~2.5GB.
# See docs/adr/0001-no-torch-fastembed.md.
#
# What this image gives the services that inherit it:
#   - the pinned Python runtime
#   - uv, for fast dependency installs
#   - the shared council-core package, already installed
#
# Build once:  make build-base   (or: docker build -f Dockerfile.base -t council-base .)

FROM python:3.12-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# curl is used by container healthchecks; the rest are build-time only.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /app

# council-core changes far less often than the services that depend on it, so
# installing it here keeps it in a cached layer across service rebuilds.
COPY packages/council-core /app/packages/council-core
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache /app/packages/council-core
